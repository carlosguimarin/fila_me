{
    "manifest_version": 3,
    "name": "Fila ME - OTRS",
    "version": "0.1.0",
    "description": "Leitura dos tickets novos do OTRS.",
    "permissions": [],
    "host_permissions": [
        "http://127.0.0.1:8765/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://helpdesk.mpsc.mp.br/otrs/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}