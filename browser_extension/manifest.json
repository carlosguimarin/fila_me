{
    "manifest_version": 3,
    "name": "Fila ME - OTRS",
    "version": "0.1.0",
    "description": "Leitura e acompanhamento dos tickets do OTRS.",
    "icons": {
        "16": "icons/owl-16.png",
        "32": "icons/owl-32.png",
        "48": "icons/owl-48.png",
        "128": "icons/owl-128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/owl-16.png",
            "32": "icons/owl-32.png"
        }
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://helpdesk.mpsc.mp.br/otrs/*",
        "http://127.0.0.1:8765/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://helpdesk.mpsc.mp.br/otrs/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}
